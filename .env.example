# OPENROUTER_API_KEY: Clé d'API OpenRouter pour l'inférence LLM (minimax/minimax-m3:free)
OPENROUTER_API_KEY=

# SUPABASE_URL: URL du projet Supabase pour la base vectorielle pgvector
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Clé de service Supabase pour les requêtes RAG
SUPABASE_SERVICE_ROLE_KEY=

# VITE_SUPABASE_URL: URL du projet Supabase (connexion app : auth + données scopées RLS)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Clé publique anon Supabase (auth côté navigateur)
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# (renseigner localement dans .env — jamais de valeur ici)
GEMINI_API_KEY=

# NOTION_TOKEN: Jeton d'intégration interne Notion (serveur MCP "notion", cf. opencode.json).
# À définir UNIQUEMENT dans l'environnement local (.env non commité ou variable
# système) — jamais de valeur réelle dans ce fichier.
NOTION_TOKEN=

# APP_URL: The URL where this applet is hosted.
# (renseigner localement dans .env — jamais de valeur ici)
APP_URL=

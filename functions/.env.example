# Variables de la Cloud Function whatsappWebhook — COPIER vers .env (jamais commité).
# .env local : utilisé par l'émulateur. En prod : mêmes clés via
# `firebase functions:secrets:set` (recommandé) ou variables d'environnement.
VERIFY_TOKEN=KeySoc26
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=1336972212826885
WHATSAPP_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Moteur IA : RAG Supabase (recherche plein-texte) + OpenRouter.
# SUPABASE_URL = même valeur que VITE_SUPABASE_URL du .env racine.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
# Modèle OpenRouter (défaut : google/gemma-4-26b-a4b-it:free, rapide + multilingue).
# Le code bascule seul sur openrouter/free si le modèle choisi disparaît (404).
# Vérifier le roster gratuit sur https://openrouter.ai/models (rotatif).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Timeouts / longueur (défauts : 25000 ms, 900 tokens).
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_MAX_TOKENS=900
